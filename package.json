{
  "name": "sentry",
  "version": "1.0.0",
  "description": "Detection rule engine. Loads YAML rules, matches against IOCs, generates findings. Part of the iris ecosystem.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "rules:reload": "tsx src/rules/loader.ts",
    "match:run": "tsx src/rules/engine.ts",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["detection-engineering", "sigma-rules", "soc", "security-automation", "threat-detection"],
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.0",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.0",
    "node-fetch": "^3.3.0",
    "yaml": "^2.7.0",
    "@hono/node-server": "^1.13.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.19.0"
  }
}
